{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Root-domain site (darkskyalmanac.com). Separate from the app worker at
  // app.darkskyalmanac.com — deploying this never touches the app.
  "name": "darkskyalmanac-www",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    // /about.html is served at /about; folders serve their index.html.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Cloudflare creates DNS records + TLS certs for these on deploy.
  "routes": [
    { "pattern": "darkskyalmanac.com", "custom_domain": true },
    { "pattern": "www.darkskyalmanac.com", "custom_domain": true }
  ]
}
